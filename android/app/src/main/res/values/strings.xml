    <!-- Tutorial -->
    <string name="tutorial_page1_title">Tap to talk</string>
    <string name="tutorial_page1_body_en">Tap the mic button and talk to Amma, just like talking to %1$s.</string>
    <string name="tutorial_page1_body_ta">மைக் பட்டனை தட்டி பேசுங்கள், %1$s கூட பேசுவது போல.</string>
    <string name="tutorial_page2_title">Hear their voice</string>
    <string name="tutorial_page2_body_en">Amma replies in %1$s\'s own voice.</string>
    <string name="tutorial_page2_body_ta">%1$s குரலிலேயே அம்மா பதில் சொல்லும்.</string>
    <string name="tutorial_page3_title">Ask for anything</string>
    <string name="tutorial_page3_body_en">Ask Amma to call, message, or play something on the TV — it\'ll take care of it.</string>
    <string name="tutorial_page3_body_ta">அழைக்கவோ, மெசேஜ் அனுப்பவோ, டிவியில் ஏதாவது போடவோ அம்மாவிடம் கேளுங்கள்.</string>
